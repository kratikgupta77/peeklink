{
  "manifest_version": 3,
  "name": "PeekLink — Safe Shortener",
  "version": "0.1.0",
  "description": "Shorten a URL and open a safe preview gate powered by PeekLink.",
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon48.png"
  },

  "action": { 
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon48.png"
    }
  },

  "background": { "service_worker": "sw.js" },

  "permissions": ["contextMenus", "activeTab", "storage", "notifications", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:9000/*"
  ],

  "options_page": "options.html",

  "web_accessible_resources": [{
    "resources": ["dist/*"],
    "matches": ["<all_urls>"]
  }]
}
