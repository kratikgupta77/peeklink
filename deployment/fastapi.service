[Unit]
Description=PeekLink FastAPI Verdicts Service
After=network.target redis.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/peeklink/verdicts
Environment="PATH=/var/www/peeklink/venv/bin"
Environment="PYTHONPATH=/var/www/peeklink/verdicts"
ExecStart=/var/www/peeklink/venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 9000 \
    --workers 4 \
    --log-level info
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

# Security
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/peeklink/verdicts /var/log/peeklink

[Install]
WantedBy=multi-user.target

